{
  "manifest_version": 2,
  "name": "Puzzle Movies Exporter",
  "version": "0.2.0",
  "description": "Export Puzzle Movies episodes and movies for puzzle-mpv.",
  "browser_specific_settings": {
    "gecko": {
      "id": "puzzle-movies-exporter@local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "https://puzzle-movies.com/*",
    "https://www.puzzle-movies.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://puzzle-movies.com/*",
        "https://www.puzzle-movies.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
